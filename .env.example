# Copy to .env and fill in values for local development.
# In production these are set on the host (Render) and must NOT be committed.

# MongoDB Atlas connection string (mongodb+srv://...). Required.
MONGO_URI=

# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_OR_KEY=

# Express port. Render sets this automatically; locally defaults to 5000.
PORT=5000

# Comma-separated list of allowed origins for CORS + Socket.io.
# Local dev: http://localhost:3000
# Production (Render): https://<your-service>.onrender.com
CORS_ORIGIN=http://localhost:3000

# development | production
NODE_ENV=development
